# Copy to .env for local development. Never commit .env.
# Production defaults (when a variable is missing) are the safe ones.

# Generate one with:
# python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me-local-dev-only

DEBUG=true

# Comma-separated. Add your computer's LAN address to test from a phone, e.g. 192.168.1.20
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated, with scheme. Needed later behind HTTPS, e.g. https://training.example.org
CSRF_TRUSTED_ORIGINS=

# Must be false locally (plain http). Leave unset in production (defaults to true).
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
